{
  "manifest_version": 3,
  "name": "Jira Refined",
  "version": "0.1.0",
  "description": "Enhances Jira Cloud with missing UX features - copy task keys, search backlog, and more.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["content.js", "backlog-search.js", "sidebar.js", "issue-details.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
